# Conexión a SQL Server (reemplaza el antipatrón de SqlConnection estática).
# Ajusta host, puerto, usuario, password y nombre de la base de datos.
DATABASE_URL="sqlserver://localhost:1433;database=BASEADACURSO;user=sa;password=TU_PASSWORD;encrypt=true;trustServerCertificate=true"

# Autenticación
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="8h"

# Servidor
PORT=3000

# Mercado Pago OAuth (credenciales de la app del VENDEDOR del POS).
# Si se dejan vacías, la vinculación funciona en modo simulación.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=http://localhost:3000/terminal/oauth/callback

# Fase 4: flags de migración gradual. Si es 'true', ese flujo usa la lógica
# NATIVA en TypeScript/Prisma en vez de los stored procedures (paridad verificada).
INVENTARIO_NATIVO=false
VENTAS_NATIVO=false
COMPRAS_NATIVO=false
AUTH_NATIVO=false
CAJA_NATIVO=false

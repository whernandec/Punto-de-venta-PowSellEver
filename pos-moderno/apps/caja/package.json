{
  "name": "@pos/caja",
  "version": "0.1.0",
  "private": true,
  "description": "App de caja (POS) — Electron + React. Hardware local y operación offline.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack:api": "node ../../scripts/empaquetar-api.mjs",
    "dist:win": "electron-vite build && npm run pack:api && electron-builder --win",
    "lint": "echo \"(sin lint aún)\""
  },
  "build": {
    "appId": "com.pse.caja",
    "productName": "PSE Caja",
    "directories": { "output": "release" },
    "asar": true,
    "npmRebuild": true,
    "files": [
      "out/**/*",
      "package.json",
      "!src",
      "!build-api",
      "!release",
      "!electron.vite.config.*",
      "!tsconfig*.json"
    ],
    "extraResources": [
      { "from": "build-api", "to": "api" }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "PSE-Caja-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PSE Caja"
    }
  },
  "dependencies": {
    "@pos/types": "*",
    "better-sqlite3": "^11.3.0",
    "recharts": "^2.12.7",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
